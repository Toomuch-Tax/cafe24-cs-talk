# ─────────────────────────────────────────────────────────────
# CS-Talk 환경변수. `npm run setup` 이 이 파일을 .env.local 로 복사하고
# 비밀키(SESSION_SECRET 등)를 자동으로 채운다. 나머지는 필요한 것만 채우면 된다.
# 배포(Vercel)에서는 같은 이름으로 프로젝트 환경변수에 넣는다.
# ─────────────────────────────────────────────────────────────

# ── 1. 꼭 필요 ───────────────────────────────────────────────
# Postgres 연결. 기본값은 `docker compose up -d` 로 띄운 로컬 DB.
# Supabase 를 쓰면 Project Settings → Database → Connection string (Transaction pooler, 6543) 값을 넣는다.
DATABASE_URL=postgres://postgres:postgres@localhost:54329/cs_talk
# 마이그레이션용 직접 연결(Supabase 의 Session/Direct, 5432). 비우면 DATABASE_URL 을 쓴다.
# POSTGRES_URL_NON_POOLING=

# 서명·암호화 키 (각각 openssl rand -hex 32). setup 이 비어 있으면 채운다.
SESSION_SECRET=
WIDGET_TOKEN_SECRET=
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=

# 이 서비스의 주소 (메일·슬랙 링크, Cafe24 OAuth 리디렉션에 쓰임). 배포 후에는 https://cs.내도메인.com 처럼.
APP_ORIGIN=http://localhost:3000

# ── 2. 내 쇼핑몰 정보 ────────────────────────────────────────
# 고객에게 보이는 브랜드 이름 (AI 답변 인사·위젯 제목·메일 제목)
NEXT_PUBLIC_BRAND_NAME=우리 쇼핑몰
# 영어 답변에 쓸 브랜드 이름 (비우면 위와 같음)
NEXT_PUBLIC_BRAND_NAME_EN=
# 쇼핑몰 주소 (끝에 / 없이). 독립 도메인이 없으면 https://<몰아이디>.cafe24.com
NEXT_PUBLIC_SHOP_URL=https://example.cafe24.com
# 위젯을 띄울 수 있는 쇼핑몰 origin (콤마 구분). 두 값을 같게 둔다.
WIDGET_ALLOWED_ORIGINS=http://localhost:3000,https://example.cafe24.com
NEXT_PUBLIC_WIDGET_ALLOWED_ORIGINS=http://localhost:3000,https://example.cafe24.com

# ── 3. Cafe24 연동 (주문·배송 조회, 상품 정보, 위젯 자동 설치) ──
# Cafe24 개발자센터 → 앱 만들기 → 앱 정보의 Client ID / Client Secret / Service Key
# 자세한 순서: docs/cafe24-app.md. 비워 두면 Cafe24 기능 없이 문의·AI 만 동작한다.
CAFE24_MALL_ID=
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_SERVICE_KEY=
# 테스트 위젯을 붙일 스킨 번호 (Cafe24 관리자 → 디자인 보관함에서 확인). 미공개 기능은 이 스킨에서만 켜진다.
NEXT_PUBLIC_CAFE24_TEST_SKIN_NO=2

# ── 4. AI 응답 (선택) ─────────────────────────────────────────
# Vercel AI Gateway 키 (vercel.com → AI Gateway → API Keys). Vercel 에 배포하면 키 없이도 동작한다.
# 비워 두면 AI 답변 없이 "문의 남기기"로만 동작한다.
AI_GATEWAY_API_KEY=

# ── 5. 선택 기능 ─────────────────────────────────────────────
# 슬랙 운영 알림 (Incoming Webhook URL). 비우면 알림을 보내지 않는다.
SLACK_WEBHOOK_URL=
# 고객 사진·동영상 첨부 저장소 (Supabase Storage 비공개 버킷). 비우면 로컬은 .data/uploads 에 저장, 운영은 첨부 기능이 꺼진다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ATTACHMENTS_BUCKET=attachments
# 운영 콘솔 구글 로그인 (Google Cloud 콘솔 → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID, 웹 애플리케이션)
# 승인된 리디렉션 URI: <APP_ORIGIN>/api/auth/google/callback. 비우면 이메일·비밀번호 로그인만 보인다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 구글 로그인을 허용할 Workspace 도메인 (콤마 구분, 예: mycompany.com). 비우면 아무도 구글로 들어올 수 없다.
GOOGLE_ALLOWED_DOMAINS=
# 비회원 답변 메일 (Resend). 발신 도메인 인증 후 EMAIL_ENABLED=true
# RESEND_API_KEY=
# EMAIL_FROM=고객센터 <help@mail.myshop.com>
# EMAIL_ENABLED=false

# ── 로컬 개발용 관리자 계정 (setup 이 로컬 DB 에 만들고 아래에 적는다. 운영 DB 에는 만들지 않음)
# DEV_LOGIN_EMAIL=dev@example.com
# DEV_LOGIN_PASSWORD=
